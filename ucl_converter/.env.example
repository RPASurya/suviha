# Copy this file to .env and set strong values before running outside localhost.
UCL_ADMIN_USERNAME=admin
UCL_ADMIN_PASSWORD=CHANGE-THIS-TO-A-LONG-RANDOM-PASSWORD
UCL_SESSION_SECRET=CHANGE-THIS-TO-A-DIFFERENT-LONG-RANDOM-SECRET
# Generate once with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep this key private and stable; changing it makes stored provider keys unreadable.
UCL_ENCRYPTION_KEY=PASTE_GENERATED_FERNET_KEY_HERE
UCL_DATABASE_PATH=./data/ucl.sqlite3
UCL_MAX_UPLOAD_MB=40
UCL_MAX_SOURCE_CHARS=180000
UCL_SESSION_HTTPS_ONLY=false
